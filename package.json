{
  "name": "cairn",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:ui": "node --test tests/ui/layout.test.mjs",
    "test:site": "node tests/site/check.mjs",
    "site:serve": "node scripts/serve-site.mjs 4350",
    "test:openapi": "mkdir -p test-results && node cli/dist/cairn.mjs export openapi tests/fixtures/openapi-collection --env Prod -o test-results/openapi.yaml && npx --yes @redocly/cli@2.63.0 lint test-results/openapi.yaml --config tests/fixtures/redocly.yaml",
    "bench:ui": "node tests/perf/ui-bench.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-opener": "^2",
    "cm6-graphql": "^0.2.2",
    "graphql": "^17.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.64.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
